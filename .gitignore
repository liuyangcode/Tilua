# Compiled Lua sources
luac.out

# luarocks build files
*.src.rock
*.zip
*.tar.gz

# Object files
*.o
*.os
*.ko
*.obj
*.elf

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo
*.def
*.exp

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# `tilua serve` scratch dir (generated dev nginx.conf, pid, logs)
.tilua/

# End-to-end run artifacts (nginx pid/logs, captured result.txt)
.e2e/

# Generated template caches. The engine creates <App>/cache/{view,html}/ even
# when caching is off, so these appear as soon as an app is booted.
**/cache/view/
**/cache/html/

# nginx runtime output from running the examples / e2e configs directly
logs/
examples/*/logs/
