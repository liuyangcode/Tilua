# Expected status for each path. Sourced by tests/run_example.sh.
#
# port: 8081
#
# check <path> <expected_status> [header:value ...]

check "/"                       200
check "/health"                 200
check "/todos"                  200

# Parameter validation: numeric ids match, non-numeric fall through to 404.
check "/todos/1"                404
check "/todos/abc"              404

# `mode:in,upper,lower` validation on a path parameter.
# `in` takes a comma-separated list; a bad value is treated as no-match (404).
check "/echo/upper"             200
check "/echo/lower"             200
check "/echo/bogus"             404

# Route-scoped access guard
check "/admin/stats"            401
check "/admin/stats"            403 --header "X-Api-Token: wrong"
check "/admin/stats"            200 --header "X-Api-Token: secret"

# Populated by the request_trace plugin through framework hooks.
check "/traces"                 200

# Throws on purpose so the on_error hook fires; see /traces afterwards.
check "/traces/boom"            500

# Controller discovery (config.auto_routes = true) with action annotations.
#
# `hello` has no annotation -> convention default GET /demo/hello.
# The others declare their method and middleware inline.
check "/demo/hello"             200

# @get /demo/echo/{word}  -> a real path parameter
check "/demo/echo/hi"           200
# @post /demo/echo        -> POST only; a GET must not match
check "/demo/echo"              404

# @get with no path       -> convention default /demo/from_verb
check "/demo/from_verb"         200

# @get /demo/methods repeated for GET/POST/PUT
check "/demo/methods"           200

# @get /demo/secure + @phases access = api_token
check "/demo/secure"            401
check "/demo/secure"            200 --header "X-Api-Token: secret"

# @get /demo/traced + @middleware request_id
check "/demo/traced"            200

# A leading-underscore method is private and must NOT be routable.
check "/demo/_secret"           404

check "/nope"                   404
